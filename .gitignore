# =========================================================
# AI PR Review Assistant - .gitignore
# 目标：
# 1. 避免提交密钥、Token、环境变量等敏感信息
# 2. 避免提交构建产物、依赖目录、日志文件
# 3. 避免提交本地 IDE、系统缓存文件
# =========================================================


# =========================================================
# 1. 敏感配置与密钥文件
# =========================================================

.env
.env.*
!.env.example

*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore

# 常见云厂商 / 第三方服务凭证
*.json.key
service-account*.json
google-credentials*.json
firebase*.json
aliyun*.json
tencent*.json
aws-credentials
.aws/
.azure/
.gcp/


# =========================================================
# 2. Claude / AI 工具本地配置
# =========================================================

.claude/settings.local.json

ai-keys.*
llm-keys.*
openai-key.*
deepseek-key.*
dashscope-key.*
qwen-key.*

prompt-debug/
llm-debug/
ai-debug/
chat-history/
review-output-local/


# =========================================================
# 3. Spring Boot / Java 本地配置
# =========================================================

application-local.yml
application-local.yaml
application-local.properties

application-dev-local.yml
application-dev-local.yaml
application-dev-local.properties

application-prod-local.yml
application-prod-local.yaml
application-prod-local.properties

bootstrap-local.yml
bootstrap-local.yaml
bootstrap-local.properties

# 示例配置允许提交
!application-example.yml
!application-example.yaml
!application-example.properties

# Maven / Java 构建产物
target/
*.class

# Maven Wrapper 保留
!.mvn/wrapper/maven-wrapper.jar

# Gradle，如后续使用
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Package files
*.jar
*.war
*.ear


# =========================================================
# 4. 前端依赖与构建产物
# =========================================================

node_modules/
dist/
.vite/
.cache/
.cache-loader/
.output/

# npm / pnpm / yarn 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 前端本地环境配置
frontend/.env
frontend/.env.*
!frontend/.env.example


# =========================================================
# 5. 日志与运行时文件
# =========================================================

logs/
log/
*.log
*.log.*

runtime/
tmp/
temp/

*.pid
*.seed
*.pid.lock


# =========================================================
# 6. 数据库本地文件
# =========================================================

# H2
*.mv.db
*.trace.db
*.h2.db

# SQLite
*.sqlite
*.sqlite3
*.db

# MySQL dump，避免误提交真实数据
*.dump

# 注意：不要全局忽略 *.sql，否则初始化 SQL / 设计 SQL 可能无法提交
# 如需忽略本地导出的 SQL，建议放到 dumps/ 目录
dumps/
db-dumps/

# 允许提交初始化 SQL
!backend/src/main/resources/db/migration/*.sql
!backend/src/main/resources/schema.sql
!backend/src/main/resources/data.sql


# =========================================================
# 7. IDE / 编辑器配置
# =========================================================

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.example.json

# Eclipse
.project
.classpath
.settings/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
.nb-gradle/


# =========================================================
# 8. 操作系统文件
# =========================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~


# =========================================================
# 9. 测试覆盖率与报告
# =========================================================

coverage/
.nyc_output/
jacoco.exec
target/site/jacoco/
surefire-reports/
failsafe-reports/


# =========================================================
# 10. Docker / 部署本地配置
# =========================================================

# Dockerfile 和 docker-compose.yml 通常需要提交
docker-compose.override.yml
docker-compose.local.yml

deploy/.env
deploy/.env.*
deploy/*secret*
deploy/*token*
deploy/*credential*


# =========================================================
# 11. 项目生成文件
# =========================================================

review-result-local.json
review-report-local.json
github-pr-cache.json

selfprompt/.claude/settings.local.json
